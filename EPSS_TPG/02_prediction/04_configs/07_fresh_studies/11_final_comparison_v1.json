{
  "schema": "fc01_final_two_run_v1",
  "target": "retrospective_day60_epss",
  "dataset": "reddit",
  "models": ["structured", "pooled_D", "tpg_D", "pooled_DM", "tpg_DM"],
  "controls": ["training_mean", "training_median"],
  "seeds": [17, 29, 43, 59, 71],
  "objective": "mse",
  "hidden": 32,
  "layers": 2,
  "readout": "mean",
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "batch_size": 8,
  "epochs": 100,
  "patience": 15,
  "edge_chunk_size": 8192,
  "threads": 4,
  "device": "cpu",
  "selection": "Earliest strict minimum selection RMSE; no assessment selection or refit",
  "checkpoint_policy": "Best only, including optimizer and deterministic replay state",
  "integration_seed": 17,
  "integration_epochs": 1,
  "integration_fold": 1,
  "bootstrap_repetitions": 20000,
  "bootstrap_seed": 6029,
  "primary_metric": "mean_seedwise_rmse",
  "primary_contrasts": [["tpg_D", "pooled_D"], ["tpg_DM", "pooled_DM"], ["pooled_D", "structured"], ["tpg_D", "structured"], ["pooled_DM", "structured"], ["tpg_DM", "structured"]],
  "bootstrap_units": ["evidence_group_and_seed", "cve_and_seed"],
  "family_alpha": 0.05,
  "high_score_threshold": 0.1,
  "top_k": [50, 100],
  "post_policy": "existing_screened_prose; retain missing-source CVEs with masks",
  "group_policy": "Run1 frozen CT07 components; Run2 NFC-whitespace exact accepted D/M document components, outcome-blind",
  "scientific_fits": {"run1": 75, "run2": 25},
  "test_access_default": false,
  "test_requires_explicit_release": true,
  "no_further_experiments_after_release": true
}
